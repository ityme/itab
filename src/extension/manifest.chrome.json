{
  "manifest_version": 3,
  "name": "iWonder Tab",
  "version": "2.0.0",
  "description": "极简美观的浏览器新标签页，支持动态粒子 / 彩带背景与自定义本地壁纸。",
  "chrome_url_overrides": {
    "newtab": "tab.html"
  },
  "action": {
    "default_title": "打开 iWonder Tab",
    "default_icon": {
      "16": "assets/logo-128.png",
      "48": "assets/logo-128.png",
      "128": "assets/logo-128.png"
    }
  },
  "icons": {
    "16": "assets/logo-128.png",
    "48": "assets/logo-128.png",
    "128": "assets/logo-128.png"
  }
}
